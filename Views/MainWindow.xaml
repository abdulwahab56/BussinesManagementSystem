<Window x:Class="BetManagement.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BetManagement.Desktop.ViewModels"
        Title="Bet Management System v3.0 - Professional Match Management" 
        Height="800" Width="1280"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" Foreground="#1A1A1A">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Windows 11 Component Styles -->
        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#0067C0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. Top Menu & Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Match Control Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Main Body Tabbed Content -->
            <RowDefinition Height="*"/>
            <!-- 4. Footer Exposure Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR / MENU NAV -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Menu DockPanel.Dock="Top" Background="Transparent" FontSize="13" Foreground="#333">
                <MenuItem Header="File"/>
                <MenuItem Header="Definitions"/>
                <MenuItem Header="Activity"/>
                <MenuItem Header="Window"/>
                <MenuItem Header="Help"/>
                <MenuItem Header="Favorites"/>
            </Menu>
        </DockPanel>

        <!-- MATCH DETAILS HEADER CARD -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Match No:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding MatchNo}" Width="60" Padding="4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <Button Content="&lt;&lt;" Command="{Binding PrevMatchCommand}" Margin="2,0" Padding="8,4"/>
                    <Button Content="&gt;&gt;" Command="{Binding NextMatchCommand}" Margin="2,0,16,0" Padding="8,4"/>

                    <TextBlock Text="Teams:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#0067C0" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding TeamsDisplay}" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Button Content="Select Teams" Margin="0,0,16,0" Padding="8,4"/>

                    <TextBlock Text="Date:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding MatchDate}" Width="120" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Match Type:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding MatchTypeList}" SelectedItem="{Binding MatchType}" Width="110" Margin="0,0,16,0"/>
                    
                    <CheckBox Content="Match Cancelled" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D13438"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT TABBED WORKSPACE -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Bet Details" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- QUICK BET INPUT FORM -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock Text="Customer" FontSize="11" Foreground="#666"/>
                                <ComboBox ItemsSource="{Binding CustomerList}" SelectedItem="{Binding SelectedCustomer}" IsEditable="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="Rate" FontSize="11" Foreground="#666"/>
                                <TextBox Text="{Binding InputRate, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0">
                                <TextBlock Text="Amount" FontSize="11" Foreground="#666"/>
                                <TextBox Text="{Binding InputAmount, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="4,0">
                                <TextBlock Text="Bet Type" FontSize="11" Foreground="#666"/>
                                <ComboBox ItemsSource="{Binding BetTypeList}" SelectedItem="{Binding SelectedBetType}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="4,0">
                                <TextBlock Text="Team" FontSize="11" Foreground="#666"/>
                                <ComboBox ItemsSource="{Binding TeamList}" SelectedItem="{Binding SelectedTeam}"/>
                            </StackPanel>

                            <Button Grid.Column="5" Content="Save Bet (Enter)" Command="{Binding SaveBetCommand}" 
                                    Style="{StaticResource PrimaryButton}" IsDefault="True" VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- VIRTUALIZED DATA GRID LEDGER -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid ItemsSource="{Binding Bets}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="S.No" Binding="{Binding SNo}" Width="60"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="Bet Amt" Binding="{Binding BetAmount, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding BetType}" Width="100"/>
                                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="90"/>
                                <DataGridTextColumn Header="B.L" Binding="{Binding BackLay}" Width="60"/>
                                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=N2}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Clients" FontSize="14" FontWeight="SemiBold">
                <TextBlock Text="Client Management &amp; Ledgers Panel" Margin="20" Foreground="#666"/>
            </TabItem>
            <TabItem Header="Match Book" FontSize="14" FontWeight="SemiBold">
                <TextBlock Text="Match Book Position Detailed Analysis" Margin="20" Foreground="#666"/>
            </TabItem>
            <TabItem Header="Results" FontSize="14" FontWeight="SemiBold">
                <TextBlock Text="Match Results &amp; Settlement Audit" Margin="20" Foreground="#666"/>
            </TabItem>
        </TabControl>

        <!-- FOOTER EXPOSURE & TEAM STATUS MONITOR -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BOOK TEAM STATUS CARD -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Book Exposure (Team Status)" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="REALTIME" DockPanel.Dock="Right" Foreground="#107C41" FontWeight="Bold" FontSize="10"/>
                    </DockPanel>
                    <Separator Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WID Position" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding TeamAExposure, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#107C41"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ZIM Position" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding TeamBExposure, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#D13438"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CLIENT TEAM STATUS CARD -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Client Position Exposure" FontWeight="Bold" FontSize="14"/>
                        <Button Content="Print Summary" DockPanel.Dock="Right" Padding="8,2" FontSize="11"/>
                    </DockPanel>
                    <Separator Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WID Net Risk" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding TeamAExposure, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#107C41"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ZIM Net Risk" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding TeamBExposure, StringFormat='{}{0:C}'}" FontSize="18" FontWeight="Bold" Foreground="#D13438"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>